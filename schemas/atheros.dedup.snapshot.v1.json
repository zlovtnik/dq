{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dq:atheros.dedup.snapshot.v1",
  "type": "object", "additionalProperties": false,
  "required": ["installation_id", "namespace", "authorized_scope", "operation", "source_revision_digest", "policy_version", "pairs", "devices", "candidates", "decisions"],
  "$defs": {
    "mac": {"type": "string", "pattern": "^([a-fA-F0-9]{2}:){5}[a-fA-F0-9]{2}$"},
    "revision": {"type": "integer", "minimum": 0},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "properties": {
    "installation_id": {"type": "string", "minLength": 1},
    "namespace": {"type": "string", "minLength": 1},
    "authorized_scope": {"type": "string", "minLength": 1},
    "operation": {"enum": ["prepare_candidates", "reconcile_decision"]},
    "source_revision_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_version": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "pairs": {
      "type": "array", "maxItems": 100000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["pair_id", "mac_a", "mac_b", "confidence", "left_revision", "right_revision", "pair_revision"],
        "properties": {
          "pair_id": {"type": "string", "minLength": 1},
          "mac_a": {"$ref": "#/$defs/mac"}, "mac_b": {"$ref": "#/$defs/mac"},
          "confidence": {"$ref": "#/$defs/confidence"},
          "left_revision": {"$ref": "#/$defs/revision"}, "right_revision": {"$ref": "#/$defs/revision"}, "pair_revision": {"$ref": "#/$defs/revision"}
        }
      }
    },
    "devices": {
      "type": "array", "maxItems": 100000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["mac", "registered", "registered_device_id", "revision"],
        "properties": {
          "mac": {"$ref": "#/$defs/mac"}, "registered": {"type": "boolean"},
          "registered_device_id": {"type": ["string", "null"]}, "revision": {"$ref": "#/$defs/revision"}
        }
      }
    },
    "candidates": {
      "type": "array", "maxItems": 100000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["candidate_id", "mac_a", "mac_b", "confidence", "status", "revision"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "mac_a": {"$ref": "#/$defs/mac"}, "mac_b": {"$ref": "#/$defs/mac"},
          "confidence": {"$ref": "#/$defs/confidence"},
          "status": {"enum": ["pending", "approved", "rejected", "deferred", "decided"]}, "revision": {"$ref": "#/$defs/revision"}
        }
      }
    },
    "decisions": {
      "type": "array", "maxItems": 100000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["candidate_id", "decision", "decided_at"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "decision": {"enum": ["merge", "not_match", "needs_more_data"]},
          "decided_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
