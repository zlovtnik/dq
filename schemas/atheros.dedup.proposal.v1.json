{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dq:atheros.dedup.proposal.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "attempt_id", "fence", "operation", "source_revision_digest", "policy_version", "candidates", "reconciliations", "summary"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "fence": {"type": "integer", "minimum": 1},
    "operation": {"enum": ["prepare_candidates", "reconcile_decision"]},
    "source_revision_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_version": {"type": "string", "minLength": 1},
    "candidates": {
      "type": "array", "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["mac_a", "mac_b", "confidence", "pair_id"],
        "properties": {
          "mac_a": {"type": "string", "pattern": "^([a-f0-9]{2}:){5}[a-f0-9]{2}$"},
          "mac_b": {"type": "string", "pattern": "^([a-f0-9]{2}:){5}[a-f0-9]{2}$"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "pair_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "reconciliations": {
      "type": "array", "maxItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["candidate_id", "decision"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "decision": {"enum": ["merge", "not_match", "needs_more_data"]}
        }
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_count", "reconciliation_count"],
      "properties": {
        "candidate_count": {"type": "integer", "minimum": 0, "maximum": 1000},
        "reconciliation_count": {"type": "integer", "minimum": 0, "maximum": 1}
      }
    }
  }
}
